      "distance to the release centre",
      "distance to the electrode"
    ],
    "per_recording": [
      "events",
      "searched time",
      "rate",
      "tissue area",
      "density",
      "sign-flipped",
      "time-reversed"
    ],
    "per_slice": [
      "events",
      "searched time",
      "rate",
      "density",
      "sign-flipped rate",
      "time-reversed rate",
      "rate above the sign-flip floor",
      "share near the release centre",
      "share on the electrode side",
      "release per minute"
