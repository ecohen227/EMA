{
  "format": "EMA spontaneous detector",
  "format_version": 1,
  "name": "Detector v5",
  "description": "The detector of the metric study (13–14 Nov 2026): a 128 µm Gaussian and the dLight template as a matched filter, events at z ≥ 8, the echo rule (ratio 1) and the end trim. About 7 events per minute per 2 mm field; sign-flipped detections about 7 % of events.",
  "recordings": {
    "searched": "unstimulated recordings",
    "skip_words": [
      "red"
    ]
  },
  "settings": {
    "frame_ms": 4.849,
    "pixel_um": 16.0,
    "first_frames": 20,
    "last_frames": 10,
    "brightness_frames": [
      10,
      95
    ],
    "block_px": 4,
    "dark_fraction": 0.3,
    "electrode_fraction": 0.5,
    "bleach_order": 4,
    "despike_frames": 3,
    "rise_ms": 12.0,
    "decay_ms": 200.0,
    "before_ms": 100.0,
    "after_ms": 600.0,
    "line_baseline": true,
    "blur_um": 128.0,
    "remove_field": true,
    "region_z": 3.0,
    "event_z": 8.0,
    "end_trim_ms": 320.0,
    "echo_rule": true,
    "echo_ms": 533.0,
    "echo_um": 256.0,
    "echo_ratio": 1.0,
    "sign_flip": true,
    "time_reversed": true,
    "fit_radius_um": 400.0,
    "good_fit_r2": 0.2,
    "max_width_um": 380.0,
    "near_um": 480.0,
    "site_um": 100.0,
    "together_ms": 1000.0
  },
  "measures": {
    "per_event": [
      "onset",
      "z",
      "fitted peak",
      "width",
      "half-maximum area",
      "size",
      "local peak",
